@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<section class="text-center p-5 text-center py-5">
    <div class="d-none mx-auto"></div>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">We could not complete that request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <small class="text-muted">Request ID: <code>@Model.RequestId</code></small>
    }
</section>
