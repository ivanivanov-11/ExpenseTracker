<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpenseTracker</title>
    <meta name="description" content="A focused personal expense tracker." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
</head>
<body class="bg-light">
    <header class="bg-white border-bottom">
        <nav class="navbar navbar-light navbar-expand-lg">
            <div class="container-xl">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span>ExpenseTracker</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Overview</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Expenses" asp-action="Index">Transactions</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Budget" asp-action="Index">Budget</a></li>
                        </ul>
                    }
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Expenses" asp-action="Create">Add expense</a>
                        }
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-xl py-4 py-lg-5">
        @if (TempData["Toast"] is string toast)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 alert-dismissible fade show" role="alert">
                <span>@toast</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="container-xl text-muted small border-top py-4 d-flex flex-column flex-md-row justify-content-between gap-2">
        <span>ExpenseTracker &copy; @DateTime.Now.Year</span>
        <span>Simple records. Clear decisions.</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
