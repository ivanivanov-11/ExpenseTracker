@model BudgetViewModel
@{
    ViewData["Title"] = "Budget";
}

<section class="col-12 col-lg-8 mx-auto">
    <div class="mb-4 mb-4">
        <p class="text-uppercase text-muted small mb-2">Monthly planning</p>
        <h1 class="display-6 mb-1">Set a budget</h1>
        <p class="text-muted mb-0">Give your spending a boundary for the current month.</p>
    </div>

    <form asp-action="Index" method="post" class="card card-body shadow-sm p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-4 mb-4">
            <span class="d-none"></span>
            <div>
                <h2 class="h5 mb-1">@Model.MonthName</h2>
                <p class="text-muted mb-0">Your limit applies to the current month and can be changed anytime.</p>
            </div>
        </div>
        
        <label asp-for="MonthlyLimit" class="form-label"></label>
        
        <div class="input-group input-group-lg">
            <span class="input-group-text">€</span>
            <input asp-for="MonthlyLimit" class="form-control" step="0.01" placeholder="0.00" />
        </div>
        
        <span asp-validation-for="MonthlyLimit" class="text-danger small"></span>
        
        <input asp-for="Year" type="hidden" />
        
        <input asp-for="Month" type="hidden" />
        
        <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
            <a class="btn btn-light" asp-controller="Home" asp-action="Index">Cancel</a>
            <button class="btn btn-primary px-4" type="submit">Save budget</button>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}