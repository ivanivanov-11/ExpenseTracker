@model ExpenseViewModel
@{
    ViewData["Title"] = "Add expense";
}
<section class="col-12 col-lg-8 mx-auto">
    <a class="text-decoration-none" asp-action="Index">Back to transactions</a>

    <div class="mb-4 mt-4 mb-4">
        <p class="text-uppercase text-muted small mb-2">New record</p>
        <h1 class="display-6 mb-1">Add an expense</h1>
        <p class="text-muted mb-0">Capture the detail now so your monthly picture stays honest.</p>
    </div>

    <form asp-action="Create" method="post" class="card card-body shadow-sm p-4">
        <partial name="CreateFormPartial" model="Model" />
        <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
            <a class="btn btn-light" asp-action="Index">Cancel</a>
            <button class="btn btn-primary px-4" type="submit">Save expense</button>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
    