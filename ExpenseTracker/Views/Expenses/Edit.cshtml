@model ExpenseViewModel
@{
    ViewData["Title"] = "Edit expense";
}

<section class="col-12 col-lg-8 mx-auto">
    <a class="text-decoration-none" asp-action="Details" asp-route-id="@Model.Id">Back to transaction</a>
    <div class="mb-4 mt-4 mb-4">
        <p class="text-uppercase text-muted small mb-2">Update record</p>
        <h1 class="display-6 mb-1">Edit expense</h1>
        <p class="text-muted mb-0">Keep the details current for a more useful ledger.</p>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm p-4">
        <partial name="CreateFormPartial" model="Model" />
        <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
            <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            <button class="btn btn-primary px-4" type="submit">Save changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
