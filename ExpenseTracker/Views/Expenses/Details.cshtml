@model ExpenseDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="col-12 col-lg-8 mx-auto">
    <a class="text-decoration-none" asp-action="Index">Back to transactions</a>
    <div class="mb-4 mt-4 mb-4 d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-end">
        <div>
            <span class="badge bg-light text-dark mb-3">@Model.CategoryName</span>
            <h1 class="display-6 mb-1">@Model.Title</h1>
            <p class="text-muted mb-0">Recorded @Model.PaidAt.ToString("dddd, dd MMMM yyyy 'at' HH:mm")</p>
        </div>
        
        <strong class="fs-2">@Model.Amount.ToString("C", CultureInfo.GetCultureInfo("eu-EU"))</strong>
    </div>

    <div class="card card-body shadow-sm p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4">Payment method</dt>
            <dd class="col-sm-8">@Model.PaymentMethod</dd>
            <dt class="col-sm-4">Notes</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)</dd>
        </dl>
    </div>
    <div class="d-flex gap-2 mt-4">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>

</section>
