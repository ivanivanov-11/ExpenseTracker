@model ExpenseViewModel
<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
<div class="row g-4">
    <div class="col-12 col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Weekly groceries" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Amount" class="form-label"></label>
        <div class="input-group input-group-lg">
            <span class="input-group-text">€</span>
            <input asp-for="Amount" class="form-control" step="0.01" placeholder="0.00" />
        </div>
        
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select form-select-lg">
            <option value="">Choose a category</option>
            @foreach (var category in Model.Categories) {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="PaymentMethod" class="form-label"></label>
        <select asp-for="PaymentMethod" class="form-select form-select-lg">
            <option>Card</option>
            <option>Cash</option>
            <option>Bank transfer</option>
            <option>Direct debit</option>
            <option>Other</option>
        </select>
        
        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="PaidAt" class="form-label"></label>
        <input asp-for="PaidAt" class="form-control form-control-lg" />
        <span asp-validation-for="PaidAt" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Describe the transaction (optional)"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
